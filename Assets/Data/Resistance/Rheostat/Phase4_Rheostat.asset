  m_Script: {fileID: 11500000, guid: 9e0d06212ab7417438d46c3054f43f0d, type: 3}
  m_Name: Phase4_Rheostat
  m_EditorClassIdentifier: Assembly-CSharp::STEM.Experiments.Rheostat.RheostatPhase
  instruction: "\u0392\u03AE\u03BC\u03B1 4: \u0395\u03BB\u03B1\u03C4\u03C4\u03CE\u03C3\u03C4\u03B5 \u03C4\u03B7 \u03C6\u03C9\u03C4\u03B5\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1 \u03C4\u03BF\u03C5 \u03BB\u03B1\u03BC\u03C0\u03C4\u03AE\u03C1\u03B1 \u03BC\u03B5 \u03C4\u03BF\u03BD \u03C1\u03BF\u03BF\u03C3\u03C4\u03AC\u03C4\u03B7.\n\n\u0395\u03BD\u03CE\u03C3\u03C4\u03B5 \u03C4\u03BF 3 \u03BC\u03B5 \u03C4\u03BF 5, \u03C4\u03BF 6 \u03BC\u03B5 \u03C4\u03BF 7 \u03BA\u03B1\u03B9 \u03C4\u03BF 8 \u03BC\u03B5 \u03C4\u03BF 4. \u03A3\u03C5\u03BD\u03B4\u03AD\u03C3\u03C4\u03B5 \u03C4\u03B1 \u03B4\u03CD\u03BF \u03BA\u03B1\u03BB\u03CE\u03B4\u03B9\u03B1 \u03C4\u03BF\u03C5 \u03B2\u03BF\u03BB\u03C4\u03BF\u03BC\u03AD\u03C4\u03C1\u03BF\u03C5 \u03B1\u03C0\u03CC \u03C4\u03BF RS101 \u03C3\u03C4\u03B9\u03C2 \u03C5\u03C0\u03BF\u03B4\u03BF\u03C7\u03AD\u03C2 7 \u03BA\u03B1\u03B9 8 \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03AC \u03B3\u03C5\u03C1\u03AF\u03C3\u03C4\u03B5 \u03C4\u03BF \u03BA\u03BF\u03C5\u03BC\u03C0\u03AF."
  resultText: "\u039C\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7: V = {V} V, I = {I} A\n\u03A1\u03BF\u03BF\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2: R = {R} \u03A9\n\n\n\u039F \u03C1\u03BF\u03BF\u03C3\u03C4\u03AC\u03C4\u03B7\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03C3\u03B5 \u03C3\u03B5\u03B9\u03C1\u03AC \u03BC\u03B5 \u03C4\u03BF\u03BD \u03BB\u03B1\u03BC\u03C0\u03C4\u03AE\u03C1\u03B1, \u03BF\u03C0\u03CC\u03C4\u03B5 \u03C0\u03B1\u03AF\u03C1\u03BD\u03B5\u03B9 \u03AD\u03BD\u03B1 \u03BC\u03AD\u03C1\u03BF\u03C2 \u03B1\u03C0\u03CC \u03C4\u03B1 5 V. \u039C\u03B5\u03B3\u03B1\u03BB\u03CD\u03C4\u03B5\u03C1\u03B7 \u03B1\u03BD\u03C4\u03AF\u03C3\u03C4\u03B1\u03C3\u03B7 \u03B1\u03C6\u03AE\u03BD\u03B5\u03B9 \u03BC\u03B9\u03BA\u03C1\u03CC\u03C4\u03B5\u03C1\u03B7 \u03C4\u03AC\u03C3\u03B7 \u03BA\u03B1\u03B9 \u03BC\u03B9\u03BA\u03C1\u03CC\u03C4\u03B5\u03C1\u03BF \u03C1\u03B5\u03CD\u03BC\u03B1 \u03C3\u03C4\u03BF\u03BD \u03BB\u03B1\u03BC\u03C0\u03C4\u03AE\u03C1\u03B1, \u03B3\u03B9' \u03B1\u03C5\u03C4\u03CC \u03BF \u03BB\u03B1\u03BC\u03C0\u03C4\u03AE\u03C1\u03B1\u03C2 \u03C6\u03C9\u03C4\u03AF\u03B6\u03B5\u03B9 \u03BB\u03B9\u03B3\u03CC\u03C4\u03B5\u03C1\u03BF.\n\n\n\u039B\u03B1\u03BC\u03C0\u03C4\u03AE\u03C1\u03B1\u03C2: R = 6.2 V / 0.5 A = 12.4 \u03A9\n\u0388\u03BB\u03B5\u03B3\u03C7\u03BF\u03C2: I = 5 / (12.4 + {R})"
