  m_Script: {fileID: 11500000, guid: 5aa0de718882e0e4fb6bbb67eec1d13f, type: 3}
  m_Name: Phase3_Parallel
  m_EditorClassIdentifier: Assembly-CSharp::STEM.Experiments.Resistance.ResistancePhase
  instruction: "\u0392\u03AE\u03BC\u03B1 3: \u03A3\u03C5\u03BD\u03B4\u03AD\u03C3\u03C4\u03B5
    \u03C4\u03B7\u03BD R1 \u03C0\u03B1\u03C1\u03AC\u03BB\u03BB\u03B7\u03BB\u03B1
    \u03BC\u03B5 \u03C4\u03B7\u03BD R2.\n\n\u0395\u03BD\u03CE\u03C3\u03C4\u03B5 \u03BC\u03B5\u03C4\u03B1\u03BE\u03CD
    \u03C4\u03BF\u03C5\u03C2 \u03C4\u03BF\u03C5\u03C2 \u03B4\u03CD\u03BF \u03B1\u03C1\u03B9\u03C3\u03C4\u03B5\u03C1\u03BF\u03CD\u03C2
    \u03B1\u03BA\u03C1\u03BF\u03B4\u03AD\u03BA\u03C4\u03B5\u03C2\n\u03BA\u03B1\u03B9
    \u03BC\u03B5\u03C4\u03AC \u03C4\u03BF\u03C5\u03C2 \u03B4\u03CD\u03BF \u03B4\u03B5\u03BE\u03B9\u03BF\u03CD\u03C2,
    \u03CE\u03C3\u03C4\u03B5 \u03BA\u03B1\u03B9 \u03BF\u03B9 \u03B4\u03CD\u03BF \u03B1\u03BD\u03C4\u03B9\u03C3\u03C4\u03AC\u03C3\u03B5\u03B9\u03C2\n\u03BD\u03B1
    \u03C3\u03C5\u03BD\u03B4\u03AD\u03BF\u03BD\u03C4\u03B1\u03B9 \u03C3\u03C4\u03B1
    \u03AF\u03B4\u03B9\u03B1 \u03B4\u03CD\u03BF \u03C3\u03B7\u03BC\u03B5\u03AF\u03B1."
  resultText: "\u039C\u03AD\u03C4\u03C1\u03B7\u03C3\u03B7: V = {V} V, I = {I} A\n\nR\u03BF\u03BB
    = V / I = {Vn} / {In} ~ {R} \u03A9\n\n\u03A0\u03B1\u03C1\u03AC\u03BB\u03BB\u03B7\u03BB\u03B7
    \u03C3\u03CD\u03BD\u03B4\u03B5\u03C3\u03B7: 1/R\u03BF\u03BB = 1/R1 + 1/R2 = 1/100
    + 1/50\nR\u03BF\u03BB = (100 * 50) / 150 = 33.3 \u03A9\n\n\u03A4\u03BF \u03B1\u03BC\u03C0\u03B5\u03C1\u03CC\u03BC\u03B5\u03C4\u03C1\u03BF
    \u03B4\u03B5\u03AF\u03C7\u03BD\u03B5\u03B9 \u03C4\u03BF \u03BF\u03BB\u03B9\u03BA\u03CC
    \u03C1\u03B5\u03CD\u03BC\u03B1.\n\u039C\u03CC\u03BD\u03BF \u03BC\u03AD\u03C3\u03B1
    \u03B1\u03C0\u03CC \u03C4\u03B7\u03BD R1: I1 = V / R1 = 5 / 100 = 0.05 A"
  requiredTopology: 3
  requiredVoltmeter: 1
  switchStartsClosed: 1
