  m_Script: {fileID: 11500000, guid: 5aa0de718882e0e4fb6bbb67eec1d13f, type: 3}
  m_Name: Phase3_Parallel
  m_EditorClassIdentifier: Assembly-CSharp::STEM.Experiments.Resistance.ResistancePhase
  instruction: 'Step 3: Connect R1 in parallel with R2.

    Join the two left terminals
    together, then the two right

    terminals, so both resistors span the same
    two points.'
  resultText: 'Measurement: V = {V} V, I = {I} A

    

    Rtot = V / I = {Vn}
    / {In} ~ {R} Ohm

    

    Parallel: 1/Rtot = 1/R1 + 1/R2 = 1/100 + 1/50

    Rtot
    = (100 * 50) / 150 = 33.3 Ohm

    

    The ammeter shows the total current.

    Through
    R1 alone: I1 = V / R1 = 5 / 100 = 0.05 A'
  requiredTopology: 3
  requiredVoltmeter: 1
  switchStartsClosed: 1
