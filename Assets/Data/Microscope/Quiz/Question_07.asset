  m_Name: Question_07
  m_EditorClassIdentifier: Assembly-CSharp::STEM.Experiments.Microscope.MicroscopeQuizQuestion
  question: "\u0393\u03B9\u03B1\u03C4\u03AF \u03C0\u03B1\u03C1\u03B1\u03C4\u03B7\u03C1\u03BF\u03CD\u03BC\u03B5
    \u03BC\u03AF\u03C4\u03C9\u03C3\u03B7 \u03C3\u03C4\u03B7\u03BD \u03AC\u03BA\u03C1\u03B7
    \u03C4\u03B7\u03C2 \u03C1\u03AF\u03B6\u03B1\u03C2 \u03BA\u03C1\u03B5\u03BC\u03BC\u03C5\u03B4\u03B9\u03BF\u03CD;"
  answers:
  - "\u0395\u03BA\u03B5\u03AF \u03C4\u03B1 \u03BA\u03CD\u03C4\u03C4\u03B1\u03C1\u03B1
    \u03B4\u03B9\u03B1\u03B9\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03B9 \u03C3\u03C5\u03BD\u03B5\u03C7\u03CE\u03C2"
  - "\u0395\u03BA\u03B5\u03AF \u03C4\u03B1 \u03BA\u03CD\u03C4\u03C4\u03B1\u03C1\u03B1
    \u03B4\u03B5\u03BD \u03AD\u03C7\u03BF\u03C5\u03BD \u03C0\u03C5\u03C1\u03AE\u03BD\u03B1"
  - "\u0395\u03BA\u03B5\u03AF \u03C4\u03B1 \u03BA\u03CD\u03C4\u03C4\u03B1\u03C1\u03B1
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BD\u03B5\u03BA\u03C1\u03AC"
  - "\u0395\u03BA\u03B5\u03AF \u03C5\u03C0\u03AC\u03C1\u03C7\u03BF\u03C5\u03BD \u03B1\u03B9\u03BC\u03BF\u03C3\u03C6\u03B1\u03AF\u03C1\u03B9\u03B1"
  explanation: "\u03A4\u03BF \u03BC\u03B5\u03C1\u03AF\u03C3\u03C4\u03C9\u03BC\u03B1
    \u03C4\u03B7\u03C2 \u03C1\u03AF\u03B6\u03B1\u03C2 \u03BC\u03B5\u03B3\u03B1\u03BB\u03CE\u03BD\u03B5\u03B9
    \u03B3\u03C1\u03AE\u03B3\u03BF\u03C1\u03B1, \u03BF\u03C0\u03CC\u03C4\u03B5 \u03B2\u03C1\u03AF\u03C3\u03BA\u03BF\u03C5\u03BC\u03B5
    \u03BA\u03CD\u03C4\u03C4\u03B1\u03C1\u03B1 \u03C3\u03B5 \u03CC\u03BB\u03B5\u03C2
    \u03C4\u03B9\u03C2 \u03C6\u03AC\u03C3\u03B5\u03B9\u03C2."
