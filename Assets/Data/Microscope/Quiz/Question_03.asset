  m_Script: {fileID: 11500000, guid: 594a652d41e51a14aaa8b078e5a824af, type: 3}
  m_Name: Question_03
  m_EditorClassIdentifier: Assembly-CSharp::STEM.Experiments.Microscope.MicroscopeQuizQuestion
  question: "\u0393\u03B9\u03B1\u03C4\u03AF \u03C7\u03C1\u03B7\u03C3\u03B9\u03BC\u03BF\u03C0\u03BF\u03B9\u03BF\u03CD\u03BC\u03B5
    \u03C4\u03BF\u03BD \u03BA\u03AC\u03C4\u03C9 \u03C6\u03C9\u03C4\u03B9\u03C3\u03BC\u03CC
    \u03B3\u03B9\u03B1 \u03AD\u03BD\u03B1 \u03C0\u03BB\u03B1\u03BA\u03AF\u03B4\u03B9\u03BF;"
  answers:
  - "\u03A4\u03BF \u03C6\u03C9\u03C2 \u03C0\u03B5\u03C1\u03BD\u03AC \u03BC\u03AD\u03C3\u03B1
    \u03B1\u03C0\u03CC \u03C4\u03BF \u03B4\u03B9\u03B1\u03C6\u03B1\u03BD\u03AD\u03C2
    \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1"
  - "\u0396\u03B5\u03C3\u03C4\u03B1\u03AF\u03BD\u03B5\u03B9 \u03C4\u03BF \u03B4\u03B5\u03AF\u03B3\u03BC\u03B1"
  - "\u039C\u03B5\u03B3\u03B1\u03BB\u03CE\u03BD\u03B5\u03B9 \u03C4\u03B7\u03BD \u03B5\u03B9\u03BA\u03CC\u03BD\u03B1"
  - "\u0395\u03AF\u03BD\u03B1\u03B9 \u03B3\u03B9\u03B1 \u03B1\u03B4\u03B9\u03B1\u03C6\u03B1\u03BD\u03AE
    \u03B1\u03BD\u03C4\u03B9\u03BA\u03B5\u03AF\u03BC\u03B5\u03BD\u03B1"
  explanation: "\u03A4\u03B1 \u03C0\u03B1\u03C1\u03B1\u03C3\u03BA\u03B5\u03C5\u03AC\u03C3\u03BC\u03B1\u03C4\u03B1
    \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BB\u03B5\u03C0\u03C4\u03AC \u03BA\u03B1\u03B9
    \u03B4\u03B9\u03B1\u03C6\u03B1\u03BD\u03AE, \u03B3\u03B9' \u03B1\u03C5\u03C4\u03CC
    \u03C4\u03B1 \u03C6\u03C9\u03C4\u03AF\u03B6\u03BF\u03C5\u03BC\u03B5 \u03B1\u03C0\u03CC
    \u03BA\u03AC\u03C4\u03C9."
