  m_Name: Question_06
  m_EditorClassIdentifier: Assembly-CSharp::STEM.Experiments.Microscope.MicroscopeQuizQuestion
  question: "\u03A0\u03BF\u03B9\u03BF\u03C2 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03BF
    \u03C1\u03CC\u03BB\u03BF\u03C2 \u03C4\u03C9\u03BD \u03B1\u03B9\u03BC\u03BF\u03C0\u03B5\u03C4\u03B1\u03BB\u03AF\u03C9\u03BD;"
  answers:
  - "\u0392\u03BF\u03B7\u03B8\u03BF\u03CD\u03BD \u03C3\u03C4\u03B7\u03BD \u03C0\u03AE\u03BE\u03B7
    \u03C4\u03BF\u03C5 \u03B1\u03AF\u03BC\u03B1\u03C4\u03BF\u03C2"
  - "\u039C\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD \u03BF\u03BE\u03C5\u03B3\u03CC\u03BD\u03BF"
  - "\u039A\u03B1\u03C4\u03B1\u03C0\u03BF\u03BB\u03B5\u03BC\u03BF\u03CD\u03BD \u03C4\u03B1
    \u03BC\u03B9\u03BA\u03C1\u03CC\u03B2\u03B9\u03B1"
  - "\u039C\u03B5\u03C4\u03B1\u03C6\u03AD\u03C1\u03BF\u03C5\u03BD \u03B8\u03C1\u03B5\u03C0\u03C4\u03B9\u03BA\u03AD\u03C2
    \u03BF\u03C5\u03C3\u03AF\u03B5\u03C2"
  explanation: "\u03A4\u03B1 \u03B1\u03B9\u03BC\u03BF\u03C0\u03B5\u03C4\u03AC\u03BB\u03B9\u03B1
    \u03C3\u03C5\u03B3\u03BA\u03B5\u03BD\u03C4\u03C1\u03CE\u03BD\u03BF\u03BD\u03C4\u03B1\u03B9
    \u03C3\u03B5 \u03AD\u03BD\u03B1 \u03C4\u03C1\u03B1\u03CD\u03BC\u03B1 \u03BA\u03B1\u03B9
    \u03B2\u03BF\u03B7\u03B8\u03BF\u03CD\u03BD \u03BD\u03B1 \u03C3\u03C4\u03B1\u03BC\u03B1\u03C4\u03AE\u03C3\u03B5\u03B9
    \u03B7 \u03B1\u03B9\u03BC\u03BF\u03C1\u03C1\u03B1\u03B3\u03AF\u03B1."
