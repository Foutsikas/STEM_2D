  m_Name: Question_02
  m_EditorClassIdentifier: Assembly-CSharp::STEM.Experiments.Microscope.MicroscopeQuizQuestion
  question: "\u03A3\u03C4\u03BF\u03BD \u03C6\u03B1\u03BA\u03CC 40x \u03B5\u03C3\u03C4\u03B9\u03AC\u03B6\u03BF\u03C5\u03BC\u03B5
    \u03BC\u03B5:"
  answers:
  - "\u03A4\u03BF\u03BD \u03BC\u03B9\u03BA\u03C1\u03BF\u03BC\u03B5\u03C4\u03C1\u03B9\u03BA\u03CC
    \u03BA\u03BF\u03C7\u03BB\u03AF\u03B1"
  - "\u03A4\u03BF\u03BD \u03BC\u03B1\u03BA\u03C1\u03BF\u03BC\u03B5\u03C4\u03C1\u03B9\u03BA\u03CC
    \u03BA\u03BF\u03C7\u03BB\u03AF\u03B1"
  - "\u03A4\u03BF\u03C5\u03C2 \u03BA\u03BF\u03C7\u03BB\u03AF\u03B5\u03C2 \u03C4\u03B7\u03C2
    \u03C4\u03C1\u03AC\u03C0\u03B5\u03B6\u03B1\u03C2"
  - "\u03A4\u03BF\u03BD \u03C4\u03C1\u03BF\u03C7\u03CC \u03C6\u03C9\u03C4\u03B5\u03B9\u03BD\u03CC\u03C4\u03B7\u03C4\u03B1\u03C2"
  explanation: "\u039F \u03C6\u03B1\u03BA\u03CC\u03C2 40x \u03B5\u03AF\u03BD\u03B1\u03B9
    \u03C0\u03BF\u03BB\u03CD \u03BA\u03BF\u03BD\u03C4\u03AC \u03C3\u03C4\u03BF \u03C0\u03BB\u03B1\u03BA\u03AF\u03B4\u03B9\u03BF.
    \u039F \u03BC\u03B1\u03BA\u03C1\u03BF\u03BC\u03B5\u03C4\u03C1\u03B9\u03BA\u03CC\u03C2
    \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF \u03BD\u03B1 \u03C4\u03BF \u03C3\u03C0\u03AC\u03C3\u03B5\u03B9."
